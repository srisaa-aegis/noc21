{
  "name": "@srisaa/noc-api",
  "version": "1.0.0",
  "private": true,
  "description": "Fire NOC Portal backend — Fastify + Drizzle + PostgreSQL.",
  "license": "MIT",
  "author": "Srisaa Technologies Private Limited",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
    "start": "node --env-file=.env dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src scripts tests",
    "db:init": "tsx --env-file-if-exists=.env scripts/pg/init-cluster.ts",
    "db:start": "tsx --env-file-if-exists=.env scripts/pg/start.ts",
    "db:stop": "tsx --env-file-if-exists=.env scripts/pg/stop.ts",
    "db:status": "tsx --env-file-if-exists=.env scripts/pg/status.ts",
    "db:create": "tsx --env-file-if-exists=.env scripts/pg/create-databases.ts",
    "db:setup": "npm run db:init && npm run db:start && npm run db:create && npm run db:migrate",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db/seed.ts",
    "db:reset": "tsx --env-file-if-exists=.env scripts/db/reset.ts",
    "dev:reset-demo": "tsx --env-file-if-exists=.env scripts/dev/reset-demo.ts",
    "jobs:run": "tsx --env-file-if-exists=.env scripts/jobs/run.ts",
    "openapi": "tsx --env-file-if-exists=.env scripts/openapi.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db/backup.ts",
    "db:restore": "tsx --env-file-if-exists=.env scripts/db/restore.ts",
    "db:load-test-data": "tsx --env-file-if-exists=.env scripts/db/generate-load.ts",
    "perf:probe": "tsx --env-file-if-exists=.env scripts/db/perf-probe.ts",
    "test": "tsx --env-file-if-exists=.env scripts/test/prepare-test-db.ts && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:int": "tsx --env-file-if-exists=.env scripts/test/prepare-test-db.ts && vitest run tests/integration tests/parity",
    "test:parity": "vitest run tests/parity",
    "test:watch": "vitest",
    "test:prepare": "tsx --env-file-if-exists=.env scripts/test/prepare-test-db.ts",
    "test:quick": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@srisaa/noc-domain": "1.0.0",
    "@srisaa/rules-engine": "1.0.0",
    "@srisaa/workflow-engine": "1.0.0",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.16.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
