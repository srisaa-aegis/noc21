# ── NOC Portal backend — development configuration ───────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=/api/v1
# API processes sharing the port (node:cluster). 1 for development; in production
# one per spare core (the 100-user load test uses 2 on this 4-core machine).
API_WORKERS=1

# ── PostgreSQL (local cluster managed by npm run db:* ) ──────────────────────
# These are intentionally NOT called PGHOST/PGPORT/PGUSER: libpq picks those up
# from the ambient shell environment and would override the project settings.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=noc
DB_PASSWORD=noc
DB_NAME=noc
DB_SUPERUSER=postgres
# Integration tests run against <DB_NAME>_test (noc_test, created by npm run db:create),
# derived from the DB_* settings above. Uncomment only to point them somewhere else:
# TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/noc_test
# PGDATA_DIR / PG_SOCKET_DIR default to <repo>/.pgdata and <repo>/var/run
# Server settings of the local cluster, applied by npm run db:start (restart to change):
# PG_SERVER_OPTIONS=-c shared_buffers=512MB -c work_mem=16MB -c maintenance_work_mem=256MB -c effective_cache_size=4GB -c random_page_cost=1.1 -c jit=off
DB_POOL_MAX=20

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Five failed sign-ins lock an account for 15 minutes.
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# Sessions: officers and admins are signed out after 8 idle hours and must sign
# in again every 12 hours (B2-6); citizens after one idle day (B2-5).
STAFF_IDLE_TIMEOUT_HOURS=8
STAFF_ABSOLUTE_HOURS=12
CITIZEN_IDLE_TIMEOUT_HOURS=24
# Password-reset links: one hour, single use (B2-7). "Set your password" links
# e-mailed at registration: 24 hours (B2-4).
RESET_LINK_MINUTES=60
SET_PASSWORD_LINK_HOURS=24
# Seeded department / admin accounts must choose a password at first sign-in
# (B2-8). Unset = true in production, false for the demo.
# SEED_FORCE_PASSWORD_CHANGE=false
# Requests per minute and client address (sign-in, register, password reset /
# everything). The built-in defaults are 10 and 300 (production); the demo is
# more generous because the browser suite signs in ~30 times from one address.
RATE_LIMIT_LOGIN_PER_MINUTE=100
RATE_LIMIT_GLOBAL_PER_MINUTE=3000

# ── Frontend ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4200
PORTAL_URL=http://localhost:4200

# ── File storage (outside the web root; S3-compliant key scheme) ─────────────
STORAGE_DRIVER=fs
# FS_STORAGE_ROOT defaults to <repo>/var/storage
# B2-10: PDF only, 10 MB per file, 250 MB per application.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PER_APPLICATION_BYTES=262144000
UPLOAD_ALLOWED_MIME=application/pdf
DOWNLOAD_LINK_TTL_SECONDS=120
# B2-9: files that are no longer used are deleted from storage after 30 days.
FILE_PURGE_AFTER_DAYS=30

# ── Behaviour ────────────────────────────────────────────────────────────────
API_DATE_FORMAT=legacy
APP_TIMEZONE=Asia/Kolkata
# Background jobs in the API process (one instance runs them: advisory lock):
# escalation reminders every day at ESCALATION_HOUR (APP_TIMEZONE), file purge
# at 02:00, expired-token clean-up every hour. `npm run jobs:run -- <job>` runs
# one by hand.
ENABLE_SCHEDULER=true
ESCALATION_HOUR=9
# OpenAPI + Swagger UI at http://127.0.0.1:3000/docs. Unset: on in development, off in production.
ENABLE_DOCS=true
# No reverse proxy: the connection's address is the client's (rate limits, audit).
TRUST_PROXY=false
LOG_LEVEL=debug
SEED_DEMO_PASSWORD=demo

# ── Development-only demo reset (npm run dev:reset-demo) ─────────────────────
ALLOW_DEMO_RESET=true
