{
  "name": "@srisaa/rules-engine",
  "version": "1.0.0",
  "description": "Generic, versioned rules engine: decision trees, decision tables and parameter sets, with explain traces.",
  "license": "MIT",
  "author": "Srisaa Technologies Private Limited",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./testing": { "types": "./dist/testing/index.d.ts", "default": "./dist/testing/index.js" }
  },
  "files": ["dist", "schemas", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
